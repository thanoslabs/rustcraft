{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/Toronto",
  "rebaseWhen": "conflicted",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "enabledManagers": [
    "asdf",
    "cargo",
    "github-actions"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "asdf"
      ],
      "addLabels": [
        "tools"
      ]
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "addLabels": [
        "rust",
        "deps"
      ]
    },
    {
      "matchDatasources": [
        "github-actions"
      ],
      "addLabels": [
        "ci"
      ]
    }
  ],
  "labels": [
    "renovate"
  ]
}
